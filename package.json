{
  "name": "envio-peru-shopify-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "App de Shopify para tarifas de envío en Perú por Departamento → Provincia → Distrito (UBIGEO).",
  "scripts": {
    "build": "remix vite:build",
    "dev": "shopify app dev",
    "start": "remix-serve ./build/server/index.js",
    "setup": "prisma generate && prisma migrate deploy && npm run ubigeo:build && npm run db:seed",
    "db:seed": "tsx prisma/seed.ts",
    "ubigeo:build": "node scripts/build-ubigeo.mjs",
    "csv:sample": "node scripts/make-sample-csv.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migracion-inicial": "node scripts/crear-migracion-inicial.mjs",
    "extension:assets": "node scripts/copiar-assets-extension.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.1",
    "@prisma/client": "^5.19.0",
    "@remix-run/node": "^2.12.0",
    "@remix-run/react": "^2.12.0",
    "@remix-run/serve": "^2.12.0",
    "@shopify/app-bridge-react": "^4.1.5",
    "@shopify/polaris": "^13.9.0",
    "@shopify/polaris-icons": "^9.3.0",
    "@shopify/shopify-app-remix": "^3.4.0",
    "@shopify/shopify-app-session-storage-prisma": "^5.1.4",
    "@shopify/ui-extensions": "2025.10.x",
    "@shopify/worldwide": "^0.7.8",
    "exceljs": "^4.4.0",
    "isbot": "^5.1.0",
    "papaparse": "^5.4.1",
    "preact": "^10.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.12.0",
    "@types/node": "^22.5.0",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "prisma": "^5.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20.10"
  },
  "overrides": {
    "tar": "^7.5.21"
  }
}

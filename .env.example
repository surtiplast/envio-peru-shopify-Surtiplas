# ---------- Shopify ----------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://tu-dominio.com
SCOPES=write_shipping,read_orders,write_orders,read_products,write_draft_orders,write_customers
SHOP_CUSTOM_DOMAIN=

# ---------- Base de datos ----------
# DATABASE_URL: la usa la app. Con Neon, la cadena CON pooler (host con -pooler).
# DIRECT_URL  : la usa Prisma para migrar. Sin pooler.
# Si tu Postgres no tiene pooler (instalación local), pon el mismo valor en ambas.
DATABASE_URL=postgresql://usuario:clave@host-pooler.region.aws.neon.tech/envio_peru?sslmode=require
DIRECT_URL=postgresql://usuario:clave@host.region.aws.neon.tech/envio_peru?sslmode=require

# ---------- Facturación (Shopify Billing API) ----------
BILLING_PLAN_NAME=Plan Profesional
BILLING_PLAN_AMOUNT=19.90
BILLING_PLAN_CURRENCY=USD
BILLING_TRIAL_DAYS=7
# En desarrollo, deja BILLING_TEST=true para no cobrar de verdad.
BILLING_TEST=true

# ---------- Geolocalización (nunca exponer al frontend) ----------
# Valores admitidos: google | nominatim | none
GEO_PROVIDER=google
GOOGLE_MAPS_API_KEY=
# Restringe la key por IP del servidor en Google Cloud Console.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=envio-peru-app/1.0 (contacto@tu-dominio.com)

# ---------- Consulta DNI / RUC (nunca exponer al frontend) ----------
# Valores admitidos: api | none
DNI_RUC_PROVIDER=api

# El DNI (RENIEC) y el RUC (SUNAT) suelen estar en endpoints DISTINTOS.
# Define los dos completos; es lo más fiable con cualquier proveedor.
DNI_RUC_API_URL_DNI=https://api.tu-proveedor.pe/v2/reniec/dni
DNI_RUC_API_URL_RUC=https://api.tu-proveedor.pe/v2/sunat/ruc

# Alternativa: una sola base. Se usará como base/dni y base/ruc.
# Solo sirve si tu proveedor comparte prefijo para ambos.
DNI_RUC_API_URL=

# Nombre del parámetro de consulta. Casi todos usan "numero".
DNI_RUC_PARAM=numero

DNI_RUC_API_KEY=
DNI_RUC_API_SECRET=
DNI_RUC_TIMEOUT_MS=6000

# ---------- Seguridad ----------
# Clave de 32+ bytes usada para firmar los tokens de la sesión de envío del cliente.
SESSION_SIGNING_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# Ventana y límite del rate limiter de los endpoints públicos.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# ---------- Diagnóstico ----------
# Clave para abrir /diagnostico?clave=...  Sin ella, la ruta devuelve 404.
# Pon una cadena larga y aleatoria; no es un secreto de Shopify, pero esa
# pantalla revela qué tiendas usan la app y los últimos errores.
DIAGNOSTICO_CLAVE=
